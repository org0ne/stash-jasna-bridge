# stash-jasna-bridge configuration. Copy to bridge.toml (chmod 600 if it holds
# license keys or tokens) and run: python3 -m jasna_bridge -c bridge.toml

[server]
host = "127.0.0.1"          # 0.0.0.0 / LAN IP when the reverse proxy is on another host
port = 8770
path_prefix = "/jasna"      # stripped when present; matches the reverse-proxy location
cors_origins = []           # e.g. ["http://192.168.1.50:7777"] for a plain-HTTP Stash

[stash]
url = "http://127.0.0.1:9999"
api_key = ""                # only needed if Stash has authentication enabled

# Optional path rewrites when Jasna sees the media under a different root.
# [[paths.map]]
# stash = "/data"
# jasna = "/storage/pool"

[jasna]
url = "http://127.0.0.1:8765"
manage_process = false      # true: the bridge starts/stops jasna itself
binary = ""                 # required when manage_process = true
workdir = ""                # cwd for the spawned process (default: the binary's directory)
log_file = ""               # managed only: append Jasna's own stdout/stderr here (pair with "--log-level", "info" in common_flags)
stream_port = 8765         # use another port (and firewall it) if Stash itself also runs a Jasna on 8765
common_flags = []           # extra flags for every preset. No license here: with Jasna 0.10
                            #   the email/key are read from Jasna's own store (Linux
                            #   ~/.config/jasna, Windows %LOCALAPPDATA%\jasna, macOS
                            #   ~/Library/Application Support/jasna); Jasna 0.11+ is activated
                            #   once with `jasna --activation-key KEY` and takes no license flags
                            #   (the bridge detects the version from the binary path or --help).
# license_file = ""         # 0.10 only: an explicit path to a license.json
start_timeout_s = 1800        # the first start on new flags builds TensorRT engines (Jasna 0.11: ~20 min for rfdetr-v6-large + unet-4x)
open_timeout_s = 60
process_idle_minutes = 15   # managed only: stop the process after this long with no stream
prewarm_path = ""           # managed only: clip to open once after start (TensorRT cache warm-up)
default_preset = "default"
custom_presets = false      # managed only: let the plugin's "Custom presets" setting (Settings >
                            #   Plugins > Jasna Switch) send its own Jasna flags with a session.
                            #   Anyone who can create a session then picks Jasna's launch flags,
                            #   minus a denylist (stream/port/browser, input/output, license,
                            #   post-export hooks, segment duration). Keep off on an open bridge.

[presets.default]
description = "Jasna defaults"
flags = []

# [presets.hq]
# description = "rfdetr-v6-large + unet-4x"
# flags = ["--detection-model", "rfdetr-v6-large", "--detection-score-threshold", "0.4",
#          "--secondary-restoration", "unet-4x", "--max-clip-size", "180", "--batch-size", "4"]

[session]
heartbeat_idle_s = 90       # release the owner after this long without a heartbeat or segment fetch
stream_linger_s = 120       # keep Jasna's stream open this long after release (warm ON/OFF/ON)
takeover_idle_s = 20        # a forced request may pre-empt an owner that has not been watching (segment fetch or unpaused heartbeat) for this long; a paused tab counts as idle
pipeline_stall_s = 180      # active & playing session, Jasna's /status still answers but no segment is served this long -> restart the pass and re-open (a paused tab never triggers it). Keep it above the time one --max-clip-size clip takes to restore: a restart mid-pass puts a seam in the viewer's timeline.
seek_spacing_s = 1.5        # minimum time between seeks forwarded to Jasna: a scrub's intermediate positions are dropped (503) instead of each starting a render pass; Jasna 0.10.0 can deadlock at a pass start. A lone seek is never delayed. 0 = forward every seek.

[auth]
mode = "none"               # none | token | stash_cookie
token = ""                  # for mode = token; the plugin sends it as Authorization: Bearer
cache_s = 300               # stash_cookie: how long a validated cookie stays trusted

[cache]                     # on-disk segment cache (Phase C)
enabled = true
dir = ""                    # default: ~/.cache/stash-jasna-bridge/segments
max_gb = 5                  # LRU by total size
version = ""                # part of the cache key; default parsed from the jasna.binary path
                            # (e.g. ".../jasna-linux-nvidia-0.10.0/jasna" -> "0.10.0"), else "v0".
                            # Set it by hand when manage_process = false, and bump it after a
                            # Jasna upgrade so old restorations are not replayed.

[gpu]                       # whole-GPU load for the queue page's sparkline (nvidia-smi, ~20 ms per sample)
sample = true               # false: never sample; also off by itself where nvidia-smi is not on PATH
sample_seconds = 3
history = 100               # samples kept for the sparkline (100 x 3 s = 5 min)
nvidia_smi_bin = ""         # blank: found on PATH

[batch]                     # offline jobs queued by the Stash jasna-batch plugin (jasna --input/--output)
enabled = false             # needs jasna.manage_process = true. One job at a time, on the stream's GPU:
                            #   a running job holds the GPU and POST /session answers 409 {"reason": "batch"}
scratch_dir = ""            # local disk Jasna writes to; default ~/.cache/stash-jasna-bridge/batch. The finished
                            #   file is moved to the job's output path (a NAS share, typically) when Jasna exits 0
min_free_gb = 20            # a job is refused when scratch or the output volume has less than this free
grace_s = 120               # wait this long after the last live session ends before a job takes the GPU
job_timeout_h = 0           # kill a job running longer than this; 0 = no limit (LTX presets can take many hours)
common_flags = []           # added to every job after jasna.common_flags, e.g. ["--retarget-high-fps"]
output_roots = []           # Stash-side prefixes an output_path must be under, e.g. ["/media/Sorted/LTX"]; [] = any
notify_plugin = "jasna-batch"  # Stash plugin + task run on every job state change, so the scene's
notify_task = "Sync jobs"      #   status tag follows the job ("" turns the callback off)
progress = true             # let Jasna print its progress bar into the job log; /jobs reports percent and ETA
keep_running_on_restart = true  # a bridge restart leaves the running Jasna alone and adopts it afterwards
ffmpeg = ""                 # for the output fix-up before the move: a job submitted with audio = "aac" gets
                            #   any non-AAC audio re-encoded (video copied), and every output with a broken
                            #   edit list (Jasna 0.11.3, constant lip-sync offset) is stream-copy remuxed;
                            #   blank: ffmpeg/ffprobe on PATH
                            #   (the unit must have KillMode=process, as deploy/stash-jasna-bridge.service does)
